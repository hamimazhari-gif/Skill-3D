 "phrases": [
  {
   "text": "Your microwave is a piece of war radar.",
   "s": 0.123,
   "e": 2.971
  },
  {
   "text": "A candy bar gave it away.",
   "s": 3.302,
   "e": 4.571
  },
  {
   "text": "In the nineteen-forties,",
   "s": 5.011,
   "e": 6.246
  },
  {
   "text": "Percy Spencer built radar for the military.",
   "s": 6.436,
   "e": 8.891
  },
  {
   "text": "He never finished grade school.",
   "s": 9.104,
   "e": 10.569
  },
  {
   "text": "One day,",
   "s": 10.917,
   "e": 11.056
  },
  {
   "text": "he stood beside a humming radar tube.",
   "s": 11.274,
   "e": 13.577
  },
  {
   "text": "The candy bar in his pocket melted.",
   "s": 13.946,
   "e": 16.144
  },
  {
   "text": "So he brought popcorn.",
   "s": 16.748,
   "e": 17.785
  },
  {
   "text": "It exploded all over the lab.",
   "s": 18.21,
   "e": 19.877
  },
  {
   "text": "Then an egg.",
   "s": 20.255,
   "e": 20.998
  },
  {
   "text": "It burst in a coworker's face.",
   "s": 21.226,
   "e": 22.869
  },
  {
   "text": "You see,",
   "s": 23.286,
   "e": 23.784
  },
  {
   "text": "those invisible waves make the water in food shake,",
   "s": 23.983,
   "e": 26.67
  },
  {
   "text": "like tiny hands rubbing together.",
   "s": 26.946,
   "e": 28.844
  },
  {
   "text": "His first oven was as tall as a man and as heavy as a piano.",
   "s": 29.349,
   "e": 32.737
  },
  {
   "text": "Today it fits on your counter.",
   "s": 33.366,
   "e": 34.733
  },
  {
   "text": "And we still use it for popcorn.",
   "s": 35.169,
   "e": 36.688
  }
 ]
