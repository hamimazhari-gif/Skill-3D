{
  "name": "skill-3d",
  "version": "1.0.0",
  "private": true,
  "description": "Video animasi 3D dengan Three.js + Remotion",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render Main out/video.mp4",
    "render:still": "remotion still Main out/thumbnail.png --frame=60",
    "upgrade": "remotion upgrade",
    "lint": "tsc --noEmit",
    "render:vertical": "remotion render Vertical out/video-vertical.mp4",
    "render:server": "remotion render Main out/video.mp4 --gl=swangle"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@remotion/captions": "^4.0.545",
    "@remotion/cli": "^4.0.545",
    "@remotion/fonts": "^4.0.545",
    "@remotion/media": "^4.0.545",
    "@remotion/media-utils": "^4.0.545",
    "@remotion/three": "^4.0.545",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.545",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2"
  }
}
