 "sentences": [
  {
   "shot": 1,
   "text": "Dulu, untuk membeli seekor ayam, kamu harus memanggul sekarung beras ke pasar.",
   "start": 0.12,
   "end": 4.96,
   "pred": 5.29
  },
  {
