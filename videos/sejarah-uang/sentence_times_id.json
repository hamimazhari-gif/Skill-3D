   "end": 22.48,
   "pred": 1.46
  },
  {
   "shot": 5,
   "text": "Lalu petani mencari tukang sepatu.",
   "start": 23.04,
   "end": 24.62,
   "pred": 2.02
  },
  {
   "shot": 5,
   "text": "Tukang sepatu malah minta seekor kambing.",
   "start": 24.92,
   "end": 26.86,
   "pred": 2.44
  },
  {
   "shot": 6,
   "text": "Setengah hari habis, kakinya pegal, berasnya masih utuh, dan ikan yang ia mau belum juga didapat.",
   "start": 27.18,
   "end": 33.9,
   "pred": 6.69
  },
  {
   "shot": 7,
   "text": "Kamu lihat, barter hanya berhasil kalau dua orang saling butuh di saat yang sama.",
   "start": 34.64,
   "end": 38.64,
   "pred": 5.02
  },
  {
