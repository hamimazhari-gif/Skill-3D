   "text": "Belum ada uang.",
   "start": 5.3,
   "end": 6.2,
   "pred": 0.84
  },
  {
   "shot": 2,
   "text": "Orang saling menukar barang: beras dengan ikan, garam dengan kain, kambing dengan gandum.",
   "start": 6.48,
   "end": 12.6,
   "pred": 5.92
  },
  {
   "shot": 3,
   "text": "Petani kita lapar ikan.",
   "start": 13.06,
   "end": 14.12,
   "pred": 1.32
  },
  {
   "shot": 3,
   "text": "Ia berjalan jauh ke dermaga, menemui seorang nelayan.",
