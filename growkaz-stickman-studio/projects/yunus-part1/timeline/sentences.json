[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.607,
  "text": "Pernahkah kamu membayangkan…"
 },
 {
  "i": 1,
  "start": 2.083,
  "end": 4.164,
  "text": "hidup di dalam perut ikan raksasa?"
 },
 {
  "i": 2,
  "start": 5.252,
  "end": 5.55,
  "text": "Gelap."
 },
 {
  "i": 3,
  "start": 6.197,
  "end": 6.644,
  "text": "Sempit."
 },
 {
  "i": 4,
  "start": 7.244,
  "end": 8.232,
  "text": "Di dasar lautan."
 },
 {
  "i": 5,
  "start": 9.297,
  "end": 10.111,
  "text": "Ini kisah nyata."
 },
 {
  "i": 6,
  "start": 10.839,
  "end": 11.853,
  "text": "Kisah seorang nabi…"
 },
 {
  "i": 7,
  "start": 12.434,
  "end": 14.11,
  "text": "Yunus bin Matta AS."
 },
 {
  "i": 8,
  "start": 14.926,
  "end": 16.62,
  "text": "Allah mengutusnya ke negeri Ninawa."
 },
 {
  "i": 9,
  "start": 17.071,
  "end": 19.271,
  "text": "Penduduknya lebih dari seratus ribu orang."
 },
 {
  "i": 10,
  "start": 19.768,
  "end": 20.822,
  "text": "Dan semuanya…"
 },
 {
  "i": 11,
  "start": 21.201,
  "end": 22.068,
  "text": "menyembah berhala."
 },
 {
  "i": 12,
  "start": 23.012,
  "end": 25.436,
  "text": "Tahun demi tahun, Nabi Yunus berdakwah."
 },
 {
  "i": 13,
  "start": 25.941,
  "end": 27.136,
  "text": "\"Sembahlah Allah…"
 },
 {
  "i": 14,
  "start": 27.594,
  "end": 28.924,
  "text": "tinggalkan berhala-berhala itu!\""
 },
 {
  "i": 15,
  "start": 29.742,
  "end": 31.049,
  "text": "Tapi mereka menutup telinga."
 },
 {
  "i": 16,
  "start": 31.669,
  "end": 32.566,
  "text": "Mereka mengejek."
 },
 {
  "i": 17,
  "start": 33.029,
  "end": 33.741,
  "text": "Mereka menolak."
 },
 {
  "i": 18,
  "start": 34.715,
  "end": 35.957,
  "text": "Hati Nabi Yunus pun lelah…"
 },
 {
  "i": 19,
  "start": 36.352,
  "end": 37.045,
  "text": "dan kecewa."
 },
 {
  "i": 20,
  "start": 37.619,
  "end": 41.494,
  "text": "Ia memperingatkan, \"Azab Allah akan datang kepada kalian!\""
 },
 {
  "i": 21,
  "start": 42.475,
  "end": 42.788,
  "text": "Lalu…"
 },
 {
  "i": 22,
  "start": 43.993,
  "end": 46.357,
  "text": "Nabi Yunus pergi meninggalkan kaumnya dalam keadaan marah."
 },
 {
  "i": 23,
  "start": 47.0,
  "end": 47.533,
  "text": "Padahal…"
 },
 {
  "i": 24,
  "start": 47.917,
  "end": 49.263,
  "text": "Allah belum mengizinkannya pergi."
 },
 {
  "i": 25,
  "start": 49.964,
  "end": 50.779,
  "text": "Ia tidak tahu…"
 },
 {
  "i": 26,
  "start": 51.402,
  "end": 54.774,
  "text": "keputusan itu akan membawanya ke ujian paling gelap dalam hidupnya."
 },
 {
  "i": 27,
  "start": 55.575,
  "end": 57.122,
  "text": "Dan ia juga tidak tahu…"
 },
 {
  "i": 28,
  "start": 57.514,
  "end": 59.044,
  "text": "apa yang terjadi pada kaumnya…"
 },
 {
  "i": 29,
  "start": 59.698,
  "end": 60.497,
  "text": "setelah ia pergi."
 }
]