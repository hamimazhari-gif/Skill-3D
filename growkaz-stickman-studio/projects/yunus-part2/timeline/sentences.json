  "end": 0.868,
  "text": "Part dua."
 },
 {
  "i": 1,
  "start": 1.623,
  "end": 3.252,
  "text": "Undian di Tengah Badai."
 },
 {
  "i": 2,
  "start": 4.933,
  "end": 6.174,
  "text": "Nabi Yunus tiba di tepi laut."
 },
 {
  "i": 3,
  "start": 6.915,
  "end": 9.421,
  "text": "Ia menumpang sebuah kapal yang penuh muatan."
 },
 {
  "i": 4,
  "start": 10.401,
  "end": 11.952,
  "text": "Awalnya, laut tenang."
 },
 {
  "i": 5,
  "start": 13.03,
  "end": 13.451,
  "text": "Lalu…"
 },
 {
  "i": 6,
  "start": 14.041,
  "end": 14.895,
  "text": "langit menghitam."
 },
 {
  "i": 7,
  "start": 15.637,
  "end": 16.576,
  "text": "Angin mengamuk."
 },
 {
  "i": 8,
  "start": 17.034,
  "end": 19.707,
  "text": "Ombak setinggi bukit menghantam kapal!"
 },
 {
  "i": 9,
  "start": 20.806,
  "end": 21.611,
  "text": "Kapal mulai oleng…"
 },
 {
  "i": 10,
  "start": 22.238,
  "end": 23.202,
  "text": "hampir tenggelam!"
 },
 {
  "i": 11,
  "start": 24.467,
  "end": 25.378,
  "text": "\"Kapal terlalu berat!"
 },
 {
  "i": 12,
  "start": 25.8,
  "end": 27.97,
  "text": "Salah satu dari kita harus turun ke laut!\""
 },
 {
  "i": 13,
  "start": 28.924,
  "end": 29.96,
  "text": "Diadakanlah undian."
 },
 {
  "i": 14,
  "start": 30.99,
  "end": 33.06,
  "text": "Nama siapa yang keluar?"
 },
 {
  "i": 15,
  "start": 33.08,
  "end": 33.375,
  "text": "Yunus."
 },
 {
  "i": 16,
  "start": 33.995,
  "end": 34.703,
  "text": "Diulang lagi…"
 },
 {
  "i": 17,
  "start": 35.59,
  "end": 36.186,
  "text": "Yunus."
 },
 {
  "i": 18,
  "start": 36.863,
  "end": 37.397,
  "text": "Dan lagi…"
 },
 {
  "i": 19,
  "start": 38.092,
  "end": 38.419,
  "text": "tetap…"
 },
 {
  "i": 20,
  "start": 39.004,
  "end": 39.518,
  "text": "Yunus."
 },
 {
  "i": 21,
  "start": 40.79,
  "end": 41.829,
  "text": "Nabi Yunus sadar."
 },
 {
  "i": 22,
  "start": 42.292,
  "end": 43.522,
  "text": "Ini bukan kebetulan."
 },
 {
  "i": 23,
  "start": 44.201,
  "end": 45.336,
  "text": "Ini teguran dari Allah."
 },
 {
  "i": 24,
  "start": 46.334,
  "end": 47.794,
  "text": "Ia pun terjun ke laut yang mengamuk."
 },
 {
  "i": 25,
  "start": 49.333,
  "end": 50.778,
  "text": "Di dalam gelapnya air…"
 },
 {
  "i": 26,
  "start": 51.551,
  "end": 53.106,
  "text": "sesuatu yang sangat besar mendekat…"
 },
 {
  "i": 27,
  "start": 54.087,
  "end": 54.855,
  "text": "membuka mulutnya…"
 },
 {
  "i": 28,
  "start": 55.554,
  "end": 57.486,
  "text": "dan menelan Nabi Yunus bulat-bulat!"
 },
 {
  "i": 29,
  "start": 58.458,
  "end": 59.681,
  "text": "Apakah ini akhir hidupnya?"
 }
]