[
 {
  "i": 0,
  "start": 0.191,
  "end": 0.726,
  "text": "Part tiga."
 },
 {
  "i": 1,
  "start": 1.449,
  "end": 2.683,
  "text": "Doa dari Tiga Kegelapan."
 },
 {
  "i": 2,
  "start": 3.692,
  "end": 4.589,
  "text": "Nabi Yunus tidak mati."
 },
 {
  "i": 3,
  "start": 5.261,
  "end": 6.914,
  "text": "Atas kehendak Allah, ia hidup…"
 },
 {
  "i": 4,
  "start": 7.645,
  "end": 8.644,
  "text": "di dalam perut ikan."
 },
 {
  "i": 5,
  "start": 9.376,
  "end": 10.532,
  "text": "Gelapnya malam."
 },
 {
  "i": 6,
  "start": 11.136,
  "end": 12.146,
  "text": "Gelapnya lautan."
 },
 {
  "i": 7,
  "start": 12.703,
  "end": 13.7,
  "text": "Gelapnya perut ikan."
 },
 {
  "i": 8,
  "start": 14.487,
  "end": 15.17,
  "text": "Tiga kegelapan…"
 },
 {
  "i": 9,
  "start": 15.786,
  "end": 16.474,
  "text": "dan ia sendirian."
 },
 {
  "i": 10,
  "start": 17.589,
  "end": 19.393,
  "text": "Di sanalah, ia menyadari kesalahannya."
 },
 {
  "i": 11,
  "start": 20.33,
  "end": 22.34,
  "text": "Dengan hati yang hancur, ia berdoa:"
 },
 {
  "i": 12,
  "start": 23.28,
  "end": 27.738,
  "text": "Laa ilaaha illaa anta, subhaanaka, innii kuntu minazh-zhaalimiin."
 },
 {
  "i": 13,
  "start": 28.578,
  "end": 29.77,
  "text": "Tidak ada Tuhan selain Engkau."
 },
 {
  "i": 14,
  "start": 30.328,
  "end": 31.178,
  "text": "Mahasuci Engkau."
 },
 {
  "i": 15,
  "start": 31.79,
  "end": 34.154,
  "text": "Sungguh, aku termasuk orang-orang yang zalim."
 },
 {
  "i": 16,
  "start": 35.531,
  "end": 36.441,
  "text": "Allah mendengar doanya."
 },
 {
  "i": 17,
  "start": 37.463,
  "end": 39.432,
  "text": "Ikan itu memuntahkannya ke daratan yang tandus."
 },
 {
  "i": 18,
  "start": 40.217,
  "end": 40.957,
  "text": "Tubuhnya lemah…"
 },
 {
  "i": 19,
  "start": 41.388,
  "end": 41.84,
  "text": "sakit…"
 },
 {
  "i": 20,
  "start": 42.4,
  "end": 42.893,
  "text": "tak berdaya."
 },
 {
  "i": 21,
  "start": 43.869,
  "end": 47.011,
  "text": "Lalu Allah menumbuhkan pohon labu untuk menaunginya, hingga ia pulih."
 },
 {
  "i": 22,
  "start": 48.045,
  "end": 49.09,
  "text": "Dan inilah kejutannya…"
 },
 {
  "i": 23,
  "start": 49.938,
  "end": 53.133,
  "text": "Setelah Nabi Yunus pergi dulu, kaumnya melihat tanda-tanda azab mendekat."
 },
 {
  "i": 24,
  "start": 53.914,
  "end": 54.826,
  "text": "Mereka ketakutan…"
 },
 {
  "i": 25,
  "start": 54.846,
  "end": 56.514,
  "text": "lalu bertobat beramai-ramai."
 },
 {
  "i": 26,
  "start": 57.389,
  "end": 58.053,
  "text": "Dan Allah…"
 },
 {
  "i": 27,
  "start": 58.364,
  "end": 59.663,
  "text": "mengangkat azab itu dari mereka."
 },
 {
  "i": 28,
  "start": 60.779,
  "end": 61.79,
  "text": "Saat Nabi Yunus kembali…"
 },
 {
  "i": 29,
  "start": 62.03,
  "end": 64.389,
  "text": "seratus ribu orang lebih menyambutnya…"
 },
 {
  "i": 30,
  "start": 64.907,
  "end": 65.804,
  "text": "dalam keadaan beriman."
 },
 {
  "i": 31,
  "start": 67.046,
  "end": 70.208,
  "text": "Hikmahnya: Sedalam apa pun kegelapan yang kamu alami…"
 },
 {
  "i": 32,
  "start": 70.756,
  "end": 72.43,
  "text": "pintu tobat selalu terbuka."
 },
 {
  "i": 33,
  "start": 73.211,
  "end": 74.691,
  "text": "Dan jangan pernah putus asa berdakwah…"
 },
 {
  "i": 34,
  "start": 75.268,
  "end": 77.106,
  "text": "karena hidayah adalah milik Allah."
 },
 {
  "i": 35,
  "start": 78.093,
  "end": 79.627,
  "text": "Ikuti terus kisah para nabi selanjutnya!"
 }
]