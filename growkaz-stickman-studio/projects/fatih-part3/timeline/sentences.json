[
 {
  "i": 0,
  "start": 0.191,
  "end": 0.709,
  "text": "Part tiga."
 },
 {
  "i": 1,
  "start": 0.729,
  "end": 3.744,
  "text": "Fajar dua puluh sembilan Mei empat belas lima puluh tiga."
 },
 {
  "i": 2,
  "start": 4.531,
  "end": 6.456,
  "text": "Kini kota terkepung dari segala arah."
 },
 {
  "i": 3,
  "start": 7.032,
  "end": 11.709,
  "text": "Sultan Muhammad memerintahkan pasukannya berpuasa, berdoa, dan bersiap."
 },
 {
  "i": 4,
  "start": 12.721,
  "end": 13.137,
  "text": "Lalu…"
 },
 {
  "i": 5,
  "start": 13.523,
  "end": 17.112,
  "text": "di pagi buta dua puluh sembilan Mei empat belas lima puluh tiga…"
 },
 {
  "i": 6,
  "start": 17.132,
  "end": 18.53,
  "text": "serangan terakhir dimulai!"
 },
 {
  "i": 7,
  "start": 19.206,
  "end": 20.157,
  "text": "Gelombang pertama…"
 },
 {
  "i": 8,
  "start": 20.682,
  "end": 21.345,
  "text": "tertahan."
 },
 {
  "i": 9,
  "start": 22.144,
  "end": 23.163,
  "text": "Gelombang kedua…"
 },
 {
  "i": 10,
  "start": 23.183,
  "end": 24.141,
  "text": "masih tertahan."
 },
 {
  "i": 11,
  "start": 24.967,
  "end": 27.011,
  "text": "Lalu pasukan terbaik, Yeniseri, maju."
 },
 {
  "i": 12,
  "start": 27.031,
  "end": 32.321,
  "text": "Dikisahkan, seorang prajurit bernama Hasan memanjat tembok di tengah hujan anak panah…"
 },
 {
  "i": 13,
  "start": 32.341,
  "end": 34.673,
  "text": "dan berhasil menancapkan bendera di atasnya…"
 },
 {
  "i": 14,
  "start": 34.954,
  "end": 36.919,
  "text": "sebelum gugur sebagai syahid."
 },
 {
  "i": 15,
  "start": 37.38,
  "end": 38.901,
  "text": "Melihat bendera itu berkibar…"
 },
 {
  "i": 16,
  "start": 38.921,
  "end": 40.64,
  "text": "semangat pasukan Utsmani meledak!"
 },
 {
  "i": 17,
  "start": 41.22,
  "end": 41.982,
  "text": "Tembok pun jebol."
 },
 {
  "i": 18,
  "start": 42.512,
  "end": 43.238,
  "text": "Konstantinopel…"
 },
 {
  "i": 19,
  "start": 43.698,
  "end": 44.563,
  "text": "akhirnya takluk."
 },
 {
  "i": 20,
  "start": 45.669,
  "end": 53.027,
  "text": "Setelah lebih dari lima puluh hari pengepungan, pemuda berusia dua puluh satu tahun itu masuk ke kota yang tak terkalahkan selama seribu tahun."
 },
 {
  "i": 21,
  "start": 54.005,
  "end": 56.715,
  "text": "Sejak hari itu, dunia mengenalnya dengan satu nama…"
 },
 {
  "i": 22,
  "start": 57.519,
  "end": 58.672,
  "text": "Muhammad Al-Fatih."
 },
 {
  "i": 23,
  "start": 59.168,
  "end": 59.88,
  "text": "Sang Penakluk."
 },
 {
  "i": 24,
  "start": 61.002,
  "end": 64.689,
  "text": "Hikmahnya: Usia muda bukan penghalang untuk melakukan hal besar."
 },
 {
  "i": 25,
  "start": 65.489,
  "end": 66.817,
  "text": "Saat jalan biasa tertutup…"
 },
 {
  "i": 26,
  "start": 67.279,
  "end": 70.711,
  "text": "iman, ilmu, dan keberanian akan menemukan jalan lain."
 },
 {
  "i": 27,
  "start": 71.623,
  "end": 73.867,
  "text": "Ikuti terus kisah-kisah hebat dalam sejarah Islam!"
 }
]