[
 {
  "i": 0,
  "start": 0.183,
  "end": 1.138,
  "text": "Ada satu negeri…"
 },
 {
  "i": 1,
  "start": 1.515,
  "end": 3.308,
  "text": "yang Allah hapus dari muka bumi."
 },
 {
  "i": 2,
  "start": 3.969,
  "end": 5.053,
  "text": "Bukan dengan banjir."
 },
 {
  "i": 3,
  "start": 5.643,
  "end": 6.388,
  "text": "Bukan dengan gempa."
 },
 {
  "i": 4,
  "start": 7.12,
  "end": 8.066,
  "text": "Tapi dengan cara…"
 },
 {
  "i": 5,
  "start": 8.365,
  "end": 8.963,
  "text": "dibalikkan."
 },
 {
  "i": 6,
  "start": 9.707,
  "end": 10.829,
  "text": "Namanya Sodom."
 },
 {
  "i": 7,
  "start": 11.43,
  "end": 12.635,
  "text": "Tanahnya subur."
 },
 {
  "i": 8,
  "start": 13.109,
  "end": 14.159,
  "text": "Hartanya melimpah."
 },
 {
  "i": 9,
  "start": 14.63,
  "end": 15.603,
  "text": "Hidupnya nyaman."
 },
 {
  "i": 10,
  "start": 16.277,
  "end": 17.246,
  "text": "Tapi penduduknya…"
 },
 {
  "i": 11,
  "start": 17.75,
  "end": 18.976,
  "text": "sudah kehilangan rasa malu."
 },
 {
  "i": 12,
  "start": 19.828,
  "end": 24.601,
  "text": "Mereka melakukan perbuatan keji yang belum pernah dilakukan siapa pun sebelumnya."
 },
 {
  "i": 13,
  "start": 25.375,
  "end": 27.26,
  "text": "Mereka merampok para musafir."
 },
 {
  "i": 14,
  "start": 27.878,
  "end": 31.159,
  "text": "Dan mereka berbuat mungkar terang-terangan, sambil tertawa."
 },
 {
  "i": 15,
  "start": 32.086,
  "end": 34.687,
  "text": "Lalu Allah mengutus seorang nabi."
 },
 {
  "i": 16,
  "start": 35.431,
  "end": 38.505,
  "text": "Nabi Luth AS, keponakan Nabi Ibrahim."
 },
 {
  "i": 17,
  "start": 39.452,
  "end": 40.357,
  "text": "\"Wahai kaumku…"
 },
 {
  "i": 18,
  "start": 40.927,
  "end": 42.268,
  "text": "bertakwalah kepada Allah."
 },
 {
  "i": 19,
  "start": 42.861,
  "end": 44.208,
  "text": "Tinggalkan perbuatan itu!\""
 },
 {
  "i": 20,
  "start": 45.257,
  "end": 46.037,
  "text": "Jawaban mereka?"
 },
 {
  "i": 21,
  "start": 46.884,
  "end": 48.101,
  "text": "\"Usir Luth dari kampung kita!"
 },
 {
  "i": 22,
  "start": 48.73,
  "end": 50.505,
  "text": "Mereka itu orang-orang yang sok suci!\""
 },
 {
  "i": 23,
  "start": 51.535,
  "end": 52.108,
  "text": "Bayangkan…"
 },
 {
  "i": 24,
  "start": 52.711,
  "end": 55.49,
  "text": "Menyeru kebaikan, tapi justru dianggap salah."
 },
 {
  "i": 25,
  "start": 56.357,
  "end": 57.641,
  "text": "Dan yang paling menyakitkan…"
 },
 {
  "i": 26,
  "start": 58.363,
  "end": 62.567,
  "text": "Musuh terbesar Nabi Luth ternyata ada di dalam rumahnya sendiri."
 },
 {
  "i": 27,
  "start": 63.479,
  "end": 63.947,
  "text": "Siapa dia?"
 }
]