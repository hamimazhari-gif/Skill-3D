[
 {
  "i": 0,
  "start": 0.275,
  "end": 1.24,
  "text": "Bagaimana mungkin…"
 },
 {
  "i": 1,
  "start": 1.26,
  "end": 6.787,
  "text": "anak yang dibuang ke sumur oleh saudaranya sendiri, kelak menjadi orang paling berpengaruh di Mesir?"
 },
 {
  "i": 2,
  "start": 7.611,
  "end": 8.315,
  "text": "Tonton sampai akhir."
 },
 {
  "i": 3,
  "start": 8.81,
  "end": 12.266,
  "text": "Ada satu detail kecil yang membongkar sebuah kebohongan besar."
 },
 {
  "i": 4,
  "start": 13.253,
  "end": 16.067,
  "text": "Yusuf kecil sangat disayangi ayahnya, Nabi Yaqub."
 },
 {
  "i": 5,
  "start": 16.681,
  "end": 22.823,
  "text": "Suatu malam, ia bermimpi: sebelas bintang, matahari, dan bulan bersujud kepadanya!"
 },
 {
  "i": 6,
  "start": 23.781,
  "end": 29.055,
  "text": "Nabi Yaqub berpesan: \"Wahai anakku, jangan ceritakan mimpimu kepada saudara-saudaramu.\""
 },
 {
  "i": 7,
  "start": 29.956,
  "end": 31.372,
  "text": "Tapi kecemburuan sudah tumbuh."
 },
 {
  "i": 8,
  "start": 32.142,
  "end": 34.06,
  "text": "\"Ayah lebih mencintai Yusuf daripada kita!\""
 },
 {
  "i": 9,
  "start": 34.822,
  "end": 36.078,
  "text": "Mereka pun menyusun rencana."
 },
 {
  "i": 10,
  "start": 36.87,
  "end": 39.367,
  "text": "\"Ayah, izinkan Yusuf bermain bersama kami.\""
 },
 {
  "i": 11,
  "start": 40.182,
  "end": 41.156,
  "text": "Nabi Yaqub khawatir."
 },
 {
  "i": 12,
  "start": 41.949,
  "end": 43.835,
  "text": "\"Aku takut dia dimakan serigala.\""
 },
 {
  "i": 13,
  "start": 44.564,
  "end": 45.268,
  "text": "Ingat kalimat ini…"
 },
 {
  "i": 14,
  "start": 45.714,
  "end": 48.047,
  "text": "karena sebentar lagi, mereka akan memakainya sendiri."
 },
 {
  "i": 15,
  "start": 48.965,
  "end": 53.141,
  "text": "Di tengah perjalanan, Yusuf dilemparkan ke dalam sumur yang gelap dan dalam."
 },
 {
  "i": 16,
  "start": 53.886,
  "end": 55.849,
  "text": "Seorang anak kecil, sendirian…"
 },
 {
  "i": 17,
  "start": 56.578,
  "end": 57.265,
  "text": "dalam kegelapan."
 },
 {
  "i": 18,
  "start": 58.056,
  "end": 59.927,
  "text": "Malamnya, mereka pulang sambil menangis."
 },
 {
  "i": 19,
  "start": 60.734,
  "end": 61.049,
  "text": "\"Ayah…"
 },
 {
  "i": 20,
  "start": 61.069,
  "end": 62.727,
  "text": "Yusuf dimakan serigala!\""
 },
 {
  "i": 21,
  "start": 63.451,
  "end": 65.536,
  "text": "Mereka membawa bajunya yang berlumuran darah."
 },
 {
  "i": 22,
  "start": 66.366,
  "end": 67.037,
  "text": "Tapi perhatikan…"
 },
 {
  "i": 23,
  "start": 67.68,
  "end": 69.449,
  "text": "bajunya sama sekali tidak robek."
 },
 {
  "i": 24,
  "start": 70.217,
  "end": 71.73,
  "text": "Hati Nabi Yaqub hancur."
 },
 {
  "i": 25,
  "start": 72.456,
  "end": 76.229,
  "text": "Namun ia hanya berkata: \"Kesabaran yang baik itulah kesabaranku.\""
 },
 {
  "i": 26,
  "start": 76.831,
  "end": 79.565,
  "text": "Kalau kamu di posisi Nabi Yaqub, apa yang kamu rasakan?"
 },
 {
  "i": 27,
  "start": 80.282,
  "end": 80.928,
  "text": "Tulis di komentar."
 },
 {
  "i": 28,
  "start": 81.681,
  "end": 84.73,
  "text": "Sementara itu, sebuah timba turun ke dalam sumur."
 },
 {
  "i": 29,
  "start": 85.57,
  "end": 86.184,
  "text": "\"Kabar gembira!"
 },
 {
  "i": 30,
  "start": 86.854,
  "end": 87.894,
  "text": "Ada seorang anak di sini!\""
 },
 {
  "i": 31,
  "start": 88.727,
  "end": 89.349,
  "text": "Yusuf diangkat…"
 },
 {
  "i": 32,
  "start": 90.051,
  "end": 92.423,
  "text": "lalu dijual sebagai budak dengan harga murah."
 },
 {
  "i": 33,
  "start": 93.198,
  "end": 95.346,
  "text": "Tapi rencana Allah baru saja dimulai."
 },
 {
  "i": 34,
  "start": 96.141,
  "end": 98.472,
  "text": "Menurutmu, ujian apa yang menunggu Yusuf di Mesir?"
 },
 {
  "i": 35,
  "start": 99.156,
  "end": 99.79,
  "text": "Tulis di komentar!"
 }
]