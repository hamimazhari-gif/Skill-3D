[
 {
  "i": 0,
  "start": 0.219,
  "end": 1.142,
  "text": "Ada satu bangsa…"
 },
 {
  "i": 1,
  "start": 1.77,
  "end": 5.728,
  "text": "yang Allah sebut belum pernah diciptakan yang seperti mereka di negeri mana pun."
 },
 {
  "i": 2,
  "start": 6.824,
  "end": 7.566,
  "text": "Mereka adalah kaum 'Ad."
 },
 {
  "i": 3,
  "start": 8.605,
  "end": 10.624,
  "text": "Tubuh mereka besar dan sangat kuat."
 },
 {
  "i": 4,
  "start": 11.465,
  "end": 12.73,
  "text": "Kota mereka bernama Iram…"
 },
 {
  "i": 5,
  "start": 13.475,
  "end": 15.386,
  "text": "kota dengan tiang-tiang yang menjulang tinggi."
 },
 {
  "i": 6,
  "start": 16.218,
  "end": 18.43,
  "text": "Di setiap bukit, mereka membangun bangunan megah…"
 },
 {
  "i": 7,
  "start": 18.884,
  "end": 19.941,
  "text": "hanya untuk bermegah-megahan."
 },
 {
  "i": 8,
  "start": 20.664,
  "end": 22.054,
  "text": "Mereka membangun benteng-benteng kokoh…"
 },
 {
  "i": 9,
  "start": 22.695,
  "end": 24.608,
  "text": "seolah-olah mereka akan hidup selamanya."
 },
 {
  "i": 10,
  "start": 25.667,
  "end": 26.587,
  "text": "Kebun-kebun subur."
 },
 {
  "i": 11,
  "start": 27.059,
  "end": 27.838,
  "text": "Ternak melimpah."
 },
 {
  "i": 12,
  "start": 28.564,
  "end": 29.541,
  "text": "Mata air mengalir."
 },
 {
  "i": 13,
  "start": 30.173,
  "end": 32.588,
  "text": "Semua kenikmatan ada pada mereka."
 },
 {
  "i": 14,
  "start": 33.657,
  "end": 33.912,
  "text": "Tapi…"
 },
 {
  "i": 15,
  "start": 34.718,
  "end": 35.807,
  "text": "mereka menyembah berhala."
 },
 {
  "i": 16,
  "start": 36.544,
  "end": 39.255,
  "text": "Dan ketika menyiksa, mereka menyiksa dengan kejam."
 },
 {
  "i": 17,
  "start": 40.698,
  "end": 43.545,
  "text": "Mereka pun menantang: Siapa yang lebih kuat dari kami?"
 },
 {
  "i": 18,
  "start": 44.699,
  "end": 45.276,
  "text": "Mereka lupa…"
 },
 {
  "i": 19,
  "start": 45.95,
  "end": 47.164,
  "text": "Allah yang menciptakan mereka…"
 },
 {
  "i": 20,
  "start": 47.52,
  "end": 48.854,
  "text": "jauh lebih kuat dari mereka."
 },
 {
  "i": 21,
  "start": 50.008,
  "end": 52.941,
  "text": "Lalu Allah mengutus seorang nabi dari kalangan mereka sendiri."
 },
 {
  "i": 22,
  "start": 53.861,
  "end": 54.277,
  "text": "Namanya…"
 },
 {
  "i": 23,
  "start": 54.657,
  "end": 54.789,
  "text": "Hud."
 }
]