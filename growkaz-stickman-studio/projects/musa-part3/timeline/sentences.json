[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.072,
  "text": "Di depan mereka…"
 },
 {
  "i": 1,
  "start": 1.504,
  "end": 2.501,
  "text": "lautan luas."
 },
 {
  "i": 2,
  "start": 3.239,
  "end": 4.037,
  "text": "Di belakang mereka…"
 },
 {
  "i": 3,
  "start": 4.487,
  "end": 7.076,
  "text": "pasukan Firaun yang tak terhitung jumlahnya."
 },
 {
  "i": 4,
  "start": 7.891,
  "end": 9.061,
  "text": "Tidak ada jalan keluar."
 },
 {
  "i": 5,
  "start": 9.788,
  "end": 10.122,
  "text": "Atau…"
 },
 {
  "i": 6,
  "start": 10.142,
  "end": 11.658,
  "text": "benarkah begitu?"
 },
 {
  "i": 7,
  "start": 13.644,
  "end": 16.009,
  "text": "Hari itu, seluruh rakyat Mesir berkumpul."
 },
 {
  "i": 8,
  "start": 16.562,
  "end": 19.363,
  "text": "Firaun yakin, Musa akan dipermalukan."
 },
 {
  "i": 9,
  "start": 20.444,
  "end": 22.862,
  "text": "Para penyihir melemparkan tali dan tongkat mereka…"
 },
 {
  "i": 10,
  "start": 23.588,
  "end": 26.809,
  "text": "Seketika, semuanya tampak seperti ular yang merayap!"
 },
 {
  "i": 11,
  "start": 27.58,
  "end": 28.566,
  "text": "Rakyat terperangah."
 },
 {
  "i": 12,
  "start": 29.372,
  "end": 32.656,
  "text": "Lalu Allah berfirman kepada Musa: \"Jangan takut!"
 },
 {
  "i": 13,
  "start": 33.264,
  "end": 34.318,
  "text": "Lemparkan tongkatmu!\""
 },
 {
  "i": 14,
  "start": 35.262,
  "end": 37.352,
  "text": "Tongkat itu berubah menjadi ular raksasa…"
 },
 {
  "i": 15,
  "start": 37.836,
  "end": 40.062,
  "text": "dan menelan semua tipu daya mereka."
 },
 {
  "i": 16,
  "start": 40.772,
  "end": 41.808,
  "text": "Hingga tak tersisa."
 },
 {
  "i": 17,
  "start": 42.874,
  "end": 43.252,
  "text": "Hening."
 },
 {
  "i": 18,
  "start": 44.222,
  "end": 45.135,
  "text": "Para penyihir tahu betul…"
 },
 {
  "i": 19,
  "start": 45.706,
  "end": 46.692,
  "text": "ini bukan sihir."
 },
 {
  "i": 20,
  "start": 47.563,
  "end": 48.659,
  "text": "Mereka langsung bersujud."
 },
 {
  "i": 21,
  "start": 49.498,
  "end": 51.926,
  "text": "\"Kami beriman kepada Tuhan Musa dan Harun!\""
 },
 {
  "i": 22,
  "start": 52.864,
  "end": 55.494,
  "text": "Firaun murka dan mengancam akan menyiksa mereka."
 },
 {
  "i": 23,
  "start": 56.348,
  "end": 57.329,
  "text": "Tapi mereka tidak gentar."
 },
 {
  "i": 24,
  "start": 57.967,
  "end": 60.126,
  "text": "Iman telah masuk ke dalam hati mereka."
 },
 {
  "i": 25,
  "start": 61.429,
  "end": 62.655,
  "text": "Firaun tetap sombong."
 },
 {
  "i": 26,
  "start": 63.222,
  "end": 68.206,
  "text": "Maka Allah memerintahkan Musa membawa Bani Israil keluar dari Mesir, di tengah malam."
 },
 {
  "i": 27,
  "start": 69.3,
  "end": 72.779,
  "text": "Saat fajar menyingsing, Firaun mengerahkan seluruh pasukannya…"
 },
 {
  "i": 28,
  "start": 73.198,
  "end": 74.309,
  "text": "dan mengejar mereka!"
 },
 {
  "i": 29,
  "start": 75.542,
  "end": 77.895,
  "text": "Kini, Bani Israil terpojok di tepi laut."
 },
 {
  "i": 30,
  "start": 78.924,
  "end": 80.056,
  "text": "\"Kita pasti akan tersusul!\""
 },
 {
  "i": 31,
  "start": 80.633,
  "end": 81.817,
  "text": "teriak mereka ketakutan."
 },
 {
  "i": 32,
  "start": 82.71,
  "end": 85.996,
  "text": "Tapi Musa menjawab dengan tenang: \"Sekali-kali tidak!"
 },
 {
  "i": 33,
  "start": 86.774,
  "end": 88.647,
  "text": "Sesungguhnya Tuhanku bersamaku."
 },
 {
  "i": 34,
  "start": 89.312,
  "end": 91.131,
  "text": "Dia akan memberi petunjuk kepadaku.\""
 },
 {
  "i": 35,
  "start": 92.291,
  "end": 95.828,
  "text": "Allah memerintahkan: \"Pukullah laut itu dengan tongkatmu!\""
 },
 {
  "i": 36,
  "start": 96.905,
  "end": 98.451,
  "text": "Musa memukulkan tongkatnya…"
 },
 {
  "i": 37,
  "start": 99.419,
  "end": 102.113,
  "text": "Dan laut pun terbelah menjadi dua!"
 },
 {
  "i": 38,
  "start": 102.897,
  "end": 105.888,
  "text": "Setiap belahannya menjulang seperti gunung yang besar!"
 },
 {
  "i": 39,
  "start": 106.889,
  "end": 108.232,
  "text": "Dasar laut menjadi jalan yang kering."
 },
 {
  "i": 40,
  "start": 109.392,
  "end": 111.649,
  "text": "Musa dan Bani Israil menyeberang dengan selamat."
 },
 {
  "i": 41,
  "start": 112.594,
  "end": 113.765,
  "text": "Firaun tak mau kalah."
 },
 {
  "i": 42,
  "start": 114.544,
  "end": 116.513,
  "text": "Ia memacu pasukannya masuk ke tengah laut…"
 },
 {
  "i": 43,
  "start": 117.594,
  "end": 119.561,
  "text": "Dan saat mereka semua berada di tengah…"
 },
 {
  "i": 44,
  "start": 120.608,
  "end": 121.775,
  "text": "Laut kembali menyatu!"
 },
 {
  "i": 45,
  "start": 122.85,
  "end": 126.832,
  "text": "Ketika air menenggelamkannya, Firaun berteriak, \"Aku beriman!\""
 },
 {
  "i": 46,
  "start": 127.819,
  "end": 129.504,
  "text": "Tapi semuanya sudah terlambat."
 },
 {
  "i": 47,
  "start": 130.434,
  "end": 131.927,
  "text": "Raja yang mengaku tuhan itu…"
 },
 {
  "i": 48,
  "start": 132.544,
  "end": 134.115,
  "text": "binasa ditelan lautan."
 },
 {
  "i": 49,
  "start": 135.305,
  "end": 141.605,
  "text": "Dari kisah Nabi Musa, kita belajar: pertolongan Allah selalu datang kepada hamba-Nya yang beriman."
 },
 {
  "i": 50,
  "start": 142.614,
  "end": 146.766,
  "text": "Jangan pernah takut menghadapi kesulitan, selama kita bertawakal kepada Allah."
 },
 {
  "i": 51,
  "start": 147.811,
  "end": 150.116,
  "text": "Karena ketika semua jalan tampak tertutup…"
 },
 {
  "i": 52,
  "start": 150.868,
  "end": 153.213,
  "text": "Allah mampu membelah lautan untukmu."
 }
]