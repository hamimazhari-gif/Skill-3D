[
 {
  "i": 0,
  "start": 0.24,
  "end": 2.089,
  "text": "Dua kali baju Yusuf menjadi saksi."
 },
 {
  "i": 1,
  "start": 2.651,
  "end": 3.609,
  "text": "Tapi yang ketiga…"
 },
 {
  "i": 2,
  "start": 3.977,
  "end": 5.123,
  "text": "akan membuatmu terharu."
 },
 {
  "i": 3,
  "start": 6.562,
  "end": 8.452,
  "text": "Di penjara, Yusuf masih menunggu."
 },
 {
  "i": 4,
  "start": 9.017,
  "end": 14.254,
  "text": "Sampai Raja Mesir bermimpi aneh: tujuh sapi gemuk dimakan tujuh sapi kurus."
 },
 {
  "i": 5,
  "start": 14.802,
  "end": 17.688,
  "text": "Tujuh bulir gandum hijau, dan tujuh yang kering."
 },
 {
  "i": 6,
  "start": 18.323,
  "end": 20.454,
  "text": "Tak seorang pun mampu menjelaskannya…"
 },
 {
  "i": 7,
  "start": 20.788,
  "end": 23.548,
  "text": "sampai seorang mantan tahanan teringat: Yusuf!"
 },
 {
  "i": 8,
  "start": 24.862,
  "end": 30.056,
  "text": "Yusuf menjelaskan: akan datang tujuh tahun panen melimpah, lalu tujuh tahun kelaparan."
 },
 {
  "i": 9,
  "start": 30.823,
  "end": 33.179,
  "text": "\"Simpanlah sebagian besar hasil panen kalian.\""
 },
 {
  "i": 10,
  "start": 33.754,
  "end": 37.313,
  "text": "Raja kagum dan memerintahkan Yusuf dibebaskan."
 },
 {
  "i": 11,
  "start": 38.086,
  "end": 39.284,
  "text": "Tapi Yusuf menolak keluar…"
 },
 {
  "i": 12,
  "start": 39.606,
  "end": 41.136,
  "text": "sebelum namanya dibersihkan."
 },
 {
  "i": 13,
  "start": 41.985,
  "end": 42.999,
  "text": "Kebenaran pun terungkap."
 },
 {
  "i": 14,
  "start": 43.749,
  "end": 47.717,
  "text": "Dan Raja mengangkatnya menjadi pengurus perbendaharaan Mesir."
 },
 {
  "i": 15,
  "start": 48.654,
  "end": 51.046,
  "text": "Bertahun-tahun kemudian, kelaparan melanda."
 },
 {
  "i": 16,
  "start": 51.591,
  "end": 54.539,
  "text": "Saudara-saudara Yusuf datang dari jauh meminta makanan."
 },
 {
  "i": 17,
  "start": 55.324,
  "end": 56.948,
  "text": "Yusuf langsung mengenali mereka."
 },
 {
  "i": 18,
  "start": 57.542,
  "end": 59.874,
  "text": "Tapi mereka sama sekali tidak mengenalinya."
 },
 {
  "i": 19,
  "start": 61.264,
  "end": 63.849,
  "text": "Kalau kamu jadi Yusuf, apa yang akan kamu lakukan?"
 },
 {
  "i": 20,
  "start": 64.416,
  "end": 64.991,
  "text": "Membalas…"
 },
 {
  "i": 21,
  "start": 65.011,
  "end": 65.993,
  "text": "atau memaafkan?"
 },
 {
  "i": 22,
  "start": 66.732,
  "end": 68.224,
  "text": "Tulis di komentar."
 },
 {
  "i": 23,
  "start": 68.917,
  "end": 72.105,
  "text": "Hingga akhirnya Yusuf berkata: \"Akulah Yusuf.\""
 },
 {
  "i": 24,
  "start": 72.783,
  "end": 73.995,
  "text": "Mereka gemetar ketakutan."
 },
 {
  "i": 25,
  "start": 74.727,
  "end": 79.059,
  "text": "Tapi Yusuf menjawab: \"Pada hari ini tidak ada cercaan atas kalian."
 },
 {
  "i": 26,
  "start": 79.543,
  "end": 81.138,
  "text": "Semoga Allah mengampuni kalian.\""
 },
 {
  "i": 27,
  "start": 82.459,
  "end": 83.824,
  "text": "Lalu ia memberikan bajunya."
 },
 {
  "i": 28,
  "start": 84.495,
  "end": 85.831,
  "text": "\"Usapkan ke wajah ayahku.\""
 },
 {
  "i": 29,
  "start": 86.808,
  "end": 90.708,
  "text": "Nabi Yaqub, yang matanya memutih karena bertahun-tahun bersedih…"
 },
 {
  "i": 30,
  "start": 91.29,
  "end": 92.371,
  "text": "kembali bisa melihat."
 },
 {
  "i": 31,
  "start": 93.928,
  "end": 95.804,
  "text": "Keluarga itu akhirnya bersatu di Mesir."
 },
 {
  "i": 32,
  "start": 96.344,
  "end": 100.347,
  "text": "Ayah, ibu, dan sebelas saudaranya tunduk memberi hormat."
 },
 {
  "i": 33,
  "start": 101.213,
  "end": 102.017,
  "text": "\"Wahai ayahku…"
 },
 {
  "i": 34,
  "start": 102.643,
  "end": 104.224,
  "text": "inilah takwil mimpiku dahulu.\""
 },
 {
  "i": 35,
  "start": 104.938,
  "end": 109.583,
  "text": "Dari sumur yang gelap, Allah mengangkat Yusuf ke kedudukan yang mulia."
 },
 {
  "i": 36,
  "start": 110.349,
  "end": 111.625,
  "text": "Apa pun ujianmu hari ini…"
 },
 {
  "i": 37,
  "start": 112.124,
  "end": 114.268,
  "text": "jangan pernah putus asa dari rahmat Allah."
 },
 {
  "i": 38,
  "start": 115.127,
  "end": 116.748,
  "text": "Pelajaran mana yang paling menyentuh hatimu?"
 },
 {
  "i": 39,
  "start": 117.431,
  "end": 118.133,
  "text": "Tulis di komentar."
 }
]