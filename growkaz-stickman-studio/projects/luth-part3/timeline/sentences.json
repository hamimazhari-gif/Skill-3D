[
 {
  "i": 0,
  "start": 0.298,
  "end": 0.856,
  "text": "Part tiga."
 },
 {
  "i": 1,
  "start": 1.473,
  "end": 3.378,
  "text": "Subuh Terakhir Negeri Sodom."
 },
 {
  "i": 2,
  "start": 4.236,
  "end": 10.232,
  "text": "Malaikat memberi perintah yang tegas: \"Pergilah di akhir malam bersama keluargamu."
 },
 {
  "i": 3,
  "start": 10.501,
  "end": 12.558,
  "text": "Jangan ada yang menoleh ke belakang…"
 },
 {
  "i": 4,
  "start": 13.22,
  "end": 14.208,
  "text": "kecuali istrimu.\""
 },
 {
  "i": 5,
  "start": 15.346,
  "end": 17.208,
  "text": "\"Azab mereka datang saat subuh."
 },
 {
  "i": 6,
  "start": 17.798,
  "end": 19.24,
  "text": "Bukankah subuh itu sudah dekat?\""
 },
 {
  "i": 7,
  "start": 20.846,
  "end": 21.71,
  "text": "Malam itu sunyi."
 },
 {
  "i": 8,
  "start": 22.396,
  "end": 25.107,
  "text": "Nabi Luth dan orang-orang beriman melangkah pergi."
 },
 {
  "i": 9,
  "start": 25.797,
  "end": 26.724,
  "text": "Tanpa menoleh."
 },
 {
  "i": 10,
  "start": 27.129,
  "end": 27.867,
  "text": "Tanpa ragu."
 },
 {
  "i": 11,
  "start": 28.898,
  "end": 31.043,
  "text": "Lalu fajar menyingsing…"
 },
 {
  "i": 12,
  "start": 32.137,
  "end": 33.816,
  "text": "Terdengar suara yang menggelegar!"
 },
 {
  "i": 13,
  "start": 34.395,
  "end": 36.282,
  "text": "Bumi Sodom terangkat ke langit…"
 },
 {
  "i": 14,
  "start": 36.828,
  "end": 38.178,
  "text": "lalu dijungkirbalikkan."
 },
 {
  "i": 15,
  "start": 39.032,
  "end": 39.76,
  "text": "Yang di atas…"
 },
 {
  "i": 16,
  "start": 40.293,
  "end": 41.006,
  "text": "menjadi di bawah."
 },
 {
  "i": 17,
  "start": 42.227,
  "end": 42.898,
  "text": "Belum berhenti."
 },
 {
  "i": 18,
  "start": 43.386,
  "end": 46.968,
  "text": "Hujan batu dari tanah yang terbakar turun bertubi-tubi."
 },
 {
  "i": 19,
  "start": 47.799,
  "end": 48.676,
  "text": "Tak ada yang tersisa."
 },
 {
  "i": 20,
  "start": 49.539,
  "end": 49.935,
  "text": "Termasuk…"
 },
 {
  "i": 21,
  "start": 50.496,
  "end": 51.456,
  "text": "istri Nabi Luth."
 },
 {
  "i": 22,
  "start": 52.23,
  "end": 54.519,
  "text": "Negeri yang dulu sombong itu…"
 },
 {
  "i": 23,
  "start": 54.922,
  "end": 56.519,
  "text": "kini hanya tinggal pelajaran."
 },
 {
  "i": 24,
  "start": 57.329,
  "end": 61.412,
  "text": "Hikmahnya: Menjadi istri seorang nabi pun tidak menyelamatkan…"
 },
 {
  "i": 25,
  "start": 61.963,
  "end": 62.487,
  "text": "tanpa iman."
 },
 {
  "i": 26,
  "start": 63.434,
  "end": 64.857,
  "text": "Dan dosa yang dibanggakan…"
 },
 {
  "i": 27,
  "start": 65.539,
  "end": 66.894,
  "text": "hanya menunggu waktu."
 },
 {
  "i": 28,
  "start": 67.921,
  "end": 70.027,
  "text": "Ikuti terus kisah para nabi selanjutnya!"
 }
]