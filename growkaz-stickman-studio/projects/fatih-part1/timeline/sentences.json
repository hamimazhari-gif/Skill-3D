[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.879,
  "text": "Selama lebih dari seribu tahun…"
 },
 {
  "i": 1,
  "start": 2.525,
  "end": 5.135,
  "text": "ada satu kota yang tak pernah berhasil ditaklukkan."
 },
 {
  "i": 2,
  "start": 6.054,
  "end": 6.975,
  "text": "Banyak pasukan datang."
 },
 {
  "i": 3,
  "start": 7.589,
  "end": 8.359,
  "text": "Semuanya pulang…"
 },
 {
  "i": 4,
  "start": 8.816,
  "end": 9.436,
  "text": "dengan kekalahan."
 },
 {
  "i": 5,
  "start": 10.644,
  "end": 12.476,
  "text": "Kota itu bernama Konstantinopel."
 },
 {
  "i": 6,
  "start": 13.466,
  "end": 15.065,
  "text": "Ibu kota Kekaisaran Romawi Timur."
 },
 {
  "i": 7,
  "start": 16.262,
  "end": 18.946,
  "text": "Ia dilindungi tembok berlapis yang tebal dan menjulang."
 },
 {
  "i": 8,
  "start": 19.989,
  "end": 20.861,
  "text": "Di sisi lain, laut."
 },
 {
  "i": 9,
  "start": 21.606,
  "end": 26.956,
  "text": "Dan di teluknya, Tanduk Emas, terbentang rantai raksasa yang menghalangi kapal mana pun untuk masuk."
 },
 {
  "i": 10,
  "start": 28.48,
  "end": 30.792,
  "text": "Tapi ada satu kalimat yang terus diingat umat Islam:"
 },
 {
  "i": 11,
  "start": 31.892,
  "end": 34.02,
  "text": "Konstantinopel pasti akan ditaklukkan."
 },
 {
  "i": 12,
  "start": 34.874,
  "end": 39.436,
  "text": "Sebaik-baik pemimpin adalah pemimpinnya, dan sebaik-baik pasukan adalah pasukannya."
 },
 {
  "i": 13,
  "start": 40.762,
  "end": 41.786,
  "text": "Ratusan tahun berlalu…"
 },
 {
  "i": 14,
  "start": 42.805,
  "end": 44.329,
  "text": "lalu lahirlah seorang anak bernama Muhammad."
 },
 {
  "i": 15,
  "start": 45.733,
  "end": 47.386,
  "text": "Sejak kecil, gurunya terus berbisik:"
 },
 {
  "i": 16,
  "start": 48.39,
  "end": 50.605,
  "text": "Engkaulah yang akan menaklukkan kota itu."
 },
 {
  "i": 17,
  "start": 52.027,
  "end": 53.088,
  "text": "Di usia sembilan belas tahun…"
 },
 {
  "i": 18,
  "start": 53.714,
  "end": 54.821,
  "text": "ia menjadi Sultan Utsmani."
 },
 {
  "i": 19,
  "start": 56.003,
  "end": 56.693,
  "text": "Dan ia bersumpah:"
 },
 {
  "i": 20,
  "start": 57.664,
  "end": 59.533,
  "text": "Aku yang akan mengambil Konstantinopel…"
 },
 {
  "i": 21,
  "start": 60.137,
  "end": 61.691,
  "text": "atau Konstantinopel yang akan mengambilku!"
 }
]