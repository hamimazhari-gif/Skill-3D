[
 {
  "i": 0,
  "start": 0.19,
  "end": 0.653,
  "text": "Part dua."
 },
 {
  "i": 1,
  "start": 1.262,
  "end": 2.854,
  "text": "Tamu yang Bukan Manusia."
 },
 {
  "i": 2,
  "start": 4.196,
  "end": 5.248,
  "text": "Musuh itu…"
 },
 {
  "i": 3,
  "start": 6.004,
  "end": 7.479,
  "text": "adalah istrinya sendiri."
 },
 {
  "i": 4,
  "start": 8.579,
  "end": 11.492,
  "text": "Diam-diam, ia memihak kaum yang durhaka."
 },
 {
  "i": 5,
  "start": 12.452,
  "end": 15.793,
  "text": "Suatu sore, datang beberapa pemuda ke rumah Nabi Luth."
 },
 {
  "i": 6,
  "start": 16.335,
  "end": 17.817,
  "text": "Wajah mereka sangat tampan."
 },
 {
  "i": 7,
  "start": 18.707,
  "end": 20.398,
  "text": "Tapi Nabi Luth justru gelisah."
 },
 {
  "i": 8,
  "start": 21.131,
  "end": 21.89,
  "text": "Dadanya sesak."
 },
 {
  "i": 9,
  "start": 22.761,
  "end": 24.773,
  "text": "\"Ini hari yang sangat sulit,\" katanya."
 },
 {
  "i": 10,
  "start": 25.458,
  "end": 26.611,
  "text": "Karena beliau tahu…"
 },
 {
  "i": 11,
  "start": 26.631,
  "end": 28.586,
  "text": "apa yang akan dilakukan kaumnya."
 },
 {
  "i": 12,
  "start": 30.05,
  "end": 30.782,
  "text": "Dan benar saja."
 },
 {
  "i": 13,
  "start": 31.468,
  "end": 33.067,
  "text": "Istrinya membocorkan kabar itu."
 },
 {
  "i": 14,
  "start": 34.099,
  "end": 34.527,
  "text": "Tak lama…"
 },
 {
  "i": 15,
  "start": 35.179,
  "end": 36.387,
  "text": "terdengar langkah kaki."
 },
 {
  "i": 16,
  "start": 37.076,
  "end": 37.832,
  "text": "Semakin banyak."
 },
 {
  "i": 17,
  "start": 38.408,
  "end": 39.262,
  "text": "Semakin dekat."
 },
 {
  "i": 18,
  "start": 40.195,
  "end": 41.67,
  "text": "Rumah Nabi Luth dikepung!"
 },
 {
  "i": 19,
  "start": 42.918,
  "end": 45.496,
  "text": "\"Wahai kaumku, takutlah kepada Allah!"
 },
 {
  "i": 20,
  "start": 46.217,
  "end": 48.236,
  "text": "Jangan permalukan aku di depan tamuku!"
 },
 {
  "i": 21,
  "start": 49.373,
  "end": 51.646,
  "text": "Tidak adakah satu pun orang berakal di antara kalian?\""
 },
 {
  "i": 22,
  "start": 52.779,
  "end": 53.427,
  "text": "Mereka tidak peduli."
 },
 {
  "i": 23,
  "start": 54.194,
  "end": 55.211,
  "text": "Pintu terus didesak."
 },
 {
  "i": 24,
  "start": 57.268,
  "end": 58.731,
  "text": "Nabi Luth berbisik pilu…"
 },
 {
  "i": 25,
  "start": 59.691,
  "end": 61.266,
  "text": "\"Andai aku punya kekuatan…"
 },
 {
  "i": 26,
  "start": 61.989,
  "end": 63.608,
  "text": "atau tempat berlindung yang kuat…\""
 },
 {
  "i": 27,
  "start": 65.316,
  "end": 67.108,
  "text": "Saat itulah para tamu berkata,"
 },
 {
  "i": 28,
  "start": 68.064,
  "end": 68.579,
  "text": "\"Wahai Luth…"
 },
 {
  "i": 29,
  "start": 69.099,
  "end": 70.968,
  "text": "kami adalah utusan Tuhanmu.\""
 },
 {
  "i": 30,
  "start": 71.972,
  "end": 72.807,
  "text": "Ternyata mereka…"
 },
 {
  "i": 31,
  "start": 73.421,
  "end": 73.89,
  "text": "malaikat."
 },
 {
  "i": 32,
  "start": 74.766,
  "end": 77.717,
  "text": "Seketika, mata para pengepung itu dibutakan."
 },
 {
  "i": 33,
  "start": 78.448,
  "end": 79.909,
  "text": "Mereka meraba-raba dalam gelap."
 },
 {
  "i": 34,
  "start": 80.996,
  "end": 81.387,
  "text": "Tapi itu…"
 },
 {
  "i": 35,
  "start": 82.085,
  "end": 82.819,
  "text": "baru permulaan."
 }
]