[
 {
  "i": 0,
  "start": 0.242,
  "end": 1.135,
  "text": "Part dua."
 },
 {
  "i": 1,
  "start": 1.357,
  "end": 3.875,
  "text": "Dakwah di Tengah Kaum yang Tersesat."
 },
 {
  "i": 2,
  "start": 4.576,
  "end": 7.157,
  "text": "Zaman itu, manusia mulai terpecah."
 },
 {
  "i": 3,
  "start": 7.711,
  "end": 12.2,
  "text": "Dikisahkan, sebagian keturunan Qabil hidup dalam kemaksiatan."
 },
 {
  "i": 4,
  "start": 12.854,
  "end": 13.882,
  "text": "Mereka lalai…"
 },
 {
  "i": 5,
  "start": 13.902,
  "end": 15.117,
  "text": "bersenang-senang…"
 },
 {
  "i": 6,
  "start": 15.137,
  "end": 16.725,
  "text": "dan melupakan Allah."
 },
 {
  "i": 7,
  "start": 17.596,
  "end": 21.248,
  "text": "Nabi Idris bangkit menyeru mereka: \"Sembahlah Allah…"
 },
 {
  "i": 8,
  "start": 21.687,
  "end": 23.28,
  "text": "tinggalkan kemungkaran…"
 },
 {
  "i": 9,
  "start": 23.3,
  "end": 24.725,
  "text": "dan berbuat adillah!\""
 },
 {
  "i": 10,
  "start": 25.726,
  "end": 26.573,
  "text": "Sebagian mendengar."
 },
 {
  "i": 11,
  "start": 27.277,
  "end": 28.585,
  "text": "Tapi banyak yang menolak."
 },
 {
  "i": 12,
  "start": 29.515,
  "end": 31.928,
  "text": "Namun Nabi Idris tidak menyerah."
 },
 {
  "i": 13,
  "start": 32.504,
  "end": 34.067,
  "text": "Siang ia berdakwah."
 },
 {
  "i": 14,
  "start": 34.087,
  "end": 35.649,
  "text": "Malam ia beribadah."
 },
 {
  "i": 15,
  "start": 36.114,
  "end": 37.035,
  "text": "Dan di sela-selanya…"
 },
 {
  "i": 16,
  "start": 37.27,
  "end": 39.775,
  "text": "ia terus bekerja dengan tangannya sendiri."
 },
 {
  "i": 17,
  "start": 40.783,
  "end": 42.625,
  "text": "Allah memujinya dalam Al-Qur'an."
 },
 {
  "i": 18,
  "start": 43.285,
  "end": 44.594,
  "text": "Ia termasuk golongan…"
 },
 {
  "i": 19,
  "start": 44.614,
  "end": 45.982,
  "text": "orang-orang yang sabar."
 },
 {
  "i": 20,
  "start": 46.6,
  "end": 49.396,
  "text": "Q S Al-Anbiya ayat delapan puluh lima."
 },
 {
  "i": 21,
  "start": 50.267,
  "end": 51.323,
  "text": "Ia juga disebut…"
 },
 {
  "i": 22,
  "start": 51.343,
  "end": 54.811,
  "text": "seorang yang sangat membenarkan dan seorang nabi."
 },
 {
  "i": 23,
  "start": 55.529,
  "end": 58.107,
  "text": "Q S Maryam ayat lima puluh enam."
 },
 {
  "i": 24,
  "start": 59.179,
  "end": 62.35,
  "text": "Lalu Allah memberinya kemuliaan yang luar biasa…"
 },
 {
  "i": 25,
  "start": 62.37,
  "end": 65.2,
  "text": "yang tidak diberikan kepada banyak manusia."
 },
 {
  "i": 26,
  "start": 66.126,
  "end": 66.626,
  "text": "Apa itu?"
 }
]