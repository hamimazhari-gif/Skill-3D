[
 {
  "i": 0,
  "start": 0.233,
  "end": 2.71,
  "text": "Dia dibesarkan di dalam istana Firaun…"
 },
 {
  "i": 1,
  "start": 3.393,
  "end": 4.779,
  "text": "Dan kini, dia kembali."
 },
 {
  "i": 2,
  "start": 5.294,
  "end": 9.42,
  "text": "Bukan sebagai pangeran, tapi untuk menantang raja paling sombong di muka bumi!"
 },
 {
  "i": 3,
  "start": 10.819,
  "end": 14.924,
  "text": "Setelah sebuah peristiwa yang mengguncang Mesir, Musa terpaksa melarikan diri."
 },
 {
  "i": 4,
  "start": 15.664,
  "end": 16.299,
  "text": "Sendirian."
 },
 {
  "i": 5,
  "start": 16.593,
  "end": 17.443,
  "text": "Tanpa bekal."
 },
 {
  "i": 6,
  "start": 18.052,
  "end": 20.3,
  "text": "Menembus padang pasir menuju negeri Madyan."
 },
 {
  "i": 7,
  "start": 21.682,
  "end": 27.957,
  "text": "Di sebuah sumur, ia melihat dua perempuan yang tak mampu memberi minum ternaknya, terdesak di antara para penggembala."
 },
 {
  "i": 8,
  "start": 28.95,
  "end": 30.997,
  "text": "Tanpa ragu, Musa menolong mereka."
 },
 {
  "i": 9,
  "start": 32.348,
  "end": 34.196,
  "text": "Kebaikan kecil itu mengubah hidupnya."
 },
 {
  "i": 10,
  "start": 35.138,
  "end": 40.193,
  "text": "Musa diterima tinggal di Madyan, menikah, dan menetap di sana selama bertahun-tahun."
 },
 {
  "i": 11,
  "start": 41.633,
  "end": 47.127,
  "text": "Hingga suatu malam, dalam perjalanan bersama keluarganya, Musa melihat cahaya api di kejauhan…"
 },
 {
  "i": 12,
  "start": 48.309,
  "end": 49.437,
  "text": "dari arah Gunung Thur."
 },
 {
  "i": 13,
  "start": 50.599,
  "end": 51.222,
  "text": "Ia mendekat."
 },
 {
  "i": 14,
  "start": 51.995,
  "end": 54.824,
  "text": "Dan di lembah suci itu, sebuah seruan memanggilnya."
 },
 {
  "i": 15,
  "start": 55.864,
  "end": 59.814,
  "text": "Allah memanggil Musa, dan mengangkatnya menjadi seorang rasul!"
 },
 {
  "i": 16,
  "start": 61.274,
  "end": 62.244,
  "text": "\"Lemparkan tongkatmu!\""
 },
 {
  "i": 17,
  "start": 62.926,
  "end": 66.23,
  "text": "Seketika, tongkat itu berubah menjadi ular besar yang bergerak cepat!"
 },
 {
  "i": 18,
  "start": 67.137,
  "end": 68.541,
  "text": "\"Masukkan tanganmu ke dalam bajumu!\""
 },
 {
  "i": 19,
  "start": 69.478,
  "end": 72.945,
  "text": "Dan tangan itu keluar bersinar putih, bukan karena penyakit."
 },
 {
  "i": 20,
  "start": 74.175,
  "end": 76.02,
  "text": "Lalu datanglah perintah yang paling berat:"
 },
 {
  "i": 21,
  "start": 76.839,
  "end": 77.848,
  "text": "\"Pergilah kepada Firaun."
 },
 {
  "i": 22,
  "start": 78.406,
  "end": 80.262,
  "text": "Sesungguhnya dia telah melampaui batas.\""
 },
 {
  "i": 23,
  "start": 81.558,
  "end": 86.598,
  "text": "Musa berdoa agar saudaranya, Harun, menemaninya, karena lisannya lebih fasih."
 },
 {
  "i": 24,
  "start": 87.669,
  "end": 88.596,
  "text": "Doa itu dikabulkan."
 },
 {
  "i": 25,
  "start": 89.536,
  "end": 91.867,
  "text": "Kini, Musa berdiri di hadapan Firaun."
 },
 {
  "i": 26,
  "start": 92.812,
  "end": 94.294,
  "text": "Penguasa yang menyebut dirinya tuhan."
 },
 {
  "i": 27,
  "start": 95.044,
  "end": 96.533,
  "text": "Tapi Firaun menolak kebenaran."
 },
 {
  "i": 28,
  "start": 97.331,
  "end": 102.982,
  "text": "Dengan angkuh, ia mengumpulkan para penyihir terbaik di seluruh Mesir untuk mempermalukan Musa di depan rakyatnya!"
 },
 {
  "i": 29,
  "start": 103.81,
  "end": 105.377,
  "text": "Tongkat melawan sihir."
 },
 {
  "i": 30,
  "start": 106.113,
  "end": 107.767,
  "text": "Kebenaran melawan kesombongan."
 },
 {
  "i": 31,
  "start": 108.638,
  "end": 109.428,
  "text": "Siapa yang akan menang?"
 },
 {
  "i": 32,
  "start": 110.321,
  "end": 111.457,
  "text": "Saksikan di part berikutnya!"
 }
]