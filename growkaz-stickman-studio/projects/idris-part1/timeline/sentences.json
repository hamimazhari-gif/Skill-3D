[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.216,
  "text": "Sebelum ada buku…"
 },
 {
  "i": 1,
  "start": 1.993,
  "end": 3.357,
  "text": "sebelum ada tulisan…"
 },
 {
  "i": 2,
  "start": 4.13,
  "end": 6.549,
  "text": "manusia hanya mengandalkan ingatan."
 },
 {
  "i": 3,
  "start": 7.745,
  "end": 11.944,
  "text": "Lalu lahirlah seorang lelaki yang mengubah segalanya."
 },
 {
  "i": 4,
  "start": 12.785,
  "end": 13.472,
  "text": "Namanya…"
 },
 {
  "i": 5,
  "start": 14.051,
  "end": 14.571,
  "text": "Idris."
 },
 {
  "i": 6,
  "start": 15.814,
  "end": 17.834,
  "text": "Ia keturunan Nabi Adam AS."
 },
 {
  "i": 7,
  "start": 18.755,
  "end": 19.367,
  "text": "Dan kelak…"
 },
 {
  "i": 8,
  "start": 19.86,
  "end": 22.494,
  "text": "menjadi kakek buyut Nabi Nuh AS."
 },
 {
  "i": 9,
  "start": 23.634,
  "end": 28.276,
  "text": "Dikisahkan, Nabi Idris adalah manusia pertama yang menulis dengan pena."
 },
 {
  "i": 10,
  "start": 29.134,
  "end": 31.888,
  "text": "Ia juga yang pertama menjahit pakaian dari kain."
 },
 {
  "i": 11,
  "start": 32.689,
  "end": 35.657,
  "text": "Sebelumnya, manusia hanya berbalut kulit hewan."
 },
 {
  "i": 12,
  "start": 36.556,
  "end": 38.532,
  "text": "Ia mempelajari bintang-bintang…"
 },
 {
  "i": 13,
  "start": 39.203,
  "end": 39.981,
  "text": "perhitungan…"
 },
 {
  "i": 14,
  "start": 40.449,
  "end": 41.781,
  "text": "dan ilmu pengetahuan."
 },
 {
  "i": 15,
  "start": 42.777,
  "end": 46.657,
  "text": "Karena itu, namanya dikaitkan dengan kata darasa…"
 },
 {
  "i": 16,
  "start": 47.391,
  "end": 48.967,
  "text": "yang berarti belajar."
 },
 {
  "i": 17,
  "start": 49.799,
  "end": 53.558,
  "text": "Ia dikenal sebagai orang yang sangat tekun belajar dan mengajar."
 },
 {
  "i": 18,
  "start": 54.431,
  "end": 58.276,
  "text": "Tapi Allah memilihnya bukan hanya karena kecerdasannya…"
 },
 {
  "i": 19,
  "start": 59.051,
  "end": 60.861,
  "text": "Allah mengangkatnya menjadi nabi."
 },
 {
  "i": 20,
  "start": 61.798,
  "end": 63.18,
  "text": "Dan tugas yang menantinya…"
 },
 {
  "i": 21,
  "start": 63.847,
  "end": 65.269,
  "text": "tidak mudah sama sekali."
 }
]