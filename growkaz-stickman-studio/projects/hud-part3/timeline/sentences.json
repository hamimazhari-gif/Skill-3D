[
 {
  "i": 0,
  "start": 0.248,
  "end": 0.853,
  "text": "Part tiga."
 },
 {
  "i": 1,
  "start": 1.34,
  "end": 3.71,
  "text": "Awan yang Ternyata Bukan Hujan."
 },
 {
  "i": 2,
  "start": 4.604,
  "end": 7.966,
  "text": "Dikisahkan, kemarau panjang melanda negeri 'Ad."
 },
 {
  "i": 3,
  "start": 8.618,
  "end": 9.271,
  "text": "Tanah retak."
 },
 {
  "i": 4,
  "start": 9.767,
  "end": 10.639,
  "text": "Kebun mengering."
 },
 {
  "i": 5,
  "start": 11.301,
  "end": 12.433,
  "text": "Mereka menunggu hujan…"
 },
 {
  "i": 6,
  "start": 12.916,
  "end": 13.848,
  "text": "berhari-hari."
 },
 {
  "i": 7,
  "start": 15.052,
  "end": 16.192,
  "text": "Lalu suatu hari…"
 },
 {
  "i": 8,
  "start": 16.918,
  "end": 20.094,
  "text": "terlihat awan hitam besar bergerak ke arah lembah mereka."
 },
 {
  "i": 9,
  "start": 20.908,
  "end": 21.987,
  "text": "Mereka bersorak gembira!"
 },
 {
  "i": 10,
  "start": 22.25,
  "end": 25.276,
  "text": "Inilah awan yang akan menurunkan hujan untuk kita!"
 },
 {
  "i": 11,
  "start": 26.312,
  "end": 28.976,
  "text": "Tapi Nabi Hud berkata: Bukan…"
 },
 {
  "i": 12,
  "start": 29.371,
  "end": 32.016,
  "text": "itulah azab yang kalian minta untuk disegerakan!"
 },
 {
  "i": 13,
  "start": 32.834,
  "end": 34.053,
  "text": "Angin datang…"
 },
 {
  "i": 14,
  "start": 34.516,
  "end": 35.146,
  "text": "Dingin."
 },
 {
  "i": 15,
  "start": 35.723,
  "end": 36.142,
  "text": "Kencang."
 },
 {
  "i": 16,
  "start": 36.64,
  "end": 37.242,
  "text": "Menderu."
 },
 {
  "i": 17,
  "start": 38.015,
  "end": 39.506,
  "text": "Selama tujuh malam…"
 },
 {
  "i": 18,
  "start": 39.526,
  "end": 40.537,
  "text": "delapan hari…"
 },
 {
  "i": 19,
  "start": 41.065,
  "end": 42.064,
  "text": "tanpa henti!"
 },
 {
  "i": 20,
  "start": 43.373,
  "end": 46.17,
  "text": "Angin itu menghancurkan segala sesuatu yang dilaluinya."
 },
 {
  "i": 21,
  "start": 47.148,
  "end": 49.318,
  "text": "Tubuh-tubuh raksasa itu terangkat…"
 },
 {
  "i": 22,
  "start": 49.54,
  "end": 50.938,
  "text": "lalu terhempas ke tanah…"
 },
 {
  "i": 23,
  "start": 51.547,
  "end": 52.3,
  "text": "bergelimpangan…"
 },
 {
  "i": 24,
  "start": 52.579,
  "end": 55.066,
  "text": "seperti batang-batang pohon kurma yang lapuk."
 },
 {
  "i": 25,
  "start": 56.09,
  "end": 57.193,
  "text": "Bangsa terkuat itu…"
 },
 {
  "i": 26,
  "start": 57.892,
  "end": 58.197,
  "text": "lenyap."
 },
 {
  "i": 27,
  "start": 59.281,
  "end": 61.234,
  "text": "Yang tersisa hanya bekas rumah-rumah mereka."
 },
 {
  "i": 28,
  "start": 62.046,
  "end": 64.707,
  "text": "Sementara Nabi Hud dan orang-orang beriman…"
 },
 {
  "i": 29,
  "start": 64.727,
  "end": 66.09,
  "text": "diselamatkan oleh Allah."
 },
 {
  "i": 30,
  "start": 66.883,
  "end": 69.357,
  "text": "Hikmahnya: Sekuat apa pun manusia…"
 },
 {
  "i": 31,
  "start": 69.807,
  "end": 71.615,
  "text": "tak ada yang bisa melawan kehendak Allah."
 },
 {
  "i": 32,
  "start": 72.326,
  "end": 74.039,
  "text": "Dan jangan pernah menantang azab-Nya."
 },
 {
  "i": 33,
  "start": 75.495,
  "end": 76.104,
  "text": "Tahukah kamu?"
 },
 {
  "i": 34,
  "start": 76.881,
  "end": 81.045,
  "text": "Setiap kali melihat awan mendung, Rasulullah SAW terlihat gelisah…"
 },
 {
  "i": 35,
  "start": 81.813,
  "end": 83.021,
  "text": "karena teringat kisah kaum 'Ad."
 },
 {
  "i": 36,
  "start": 84.338,
  "end": 86.372,
  "text": "Ikuti terus kisah para nabi selanjutnya!"
 }
]