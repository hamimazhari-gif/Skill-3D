[
 {
  "i": 0,
  "start": 0.402,
  "end": 0.809,
  "text": "Part dua."
 },
 {
  "i": 1,
  "start": 1.248,
  "end": 3.014,
  "text": "Silakan Lakukan Tipu Daya Kalian!"
 },
 {
  "i": 2,
  "start": 4.407,
  "end": 6.09,
  "text": "Nabi Hud berdiri di hadapan kaumnya."
 },
 {
  "i": 3,
  "start": 7.124,
  "end": 8.107,
  "text": "Wahai kaumku…"
 },
 {
  "i": 4,
  "start": 8.404,
  "end": 9.531,
  "text": "sembahlah Allah."
 },
 {
  "i": 5,
  "start": 9.967,
  "end": 11.949,
  "text": "Tidak ada Tuhan bagi kalian selain Dia."
 },
 {
  "i": 6,
  "start": 12.701,
  "end": 14.062,
  "text": "Mohonlah ampunan kepada-Nya…"
 },
 {
  "i": 7,
  "start": 14.587,
  "end": 17.014,
  "text": "niscaya Dia menurunkan hujan yang lebat…"
 },
 {
  "i": 8,
  "start": 17.418,
  "end": 18.791,
  "text": "dan menambah kekuatan kalian."
 },
 {
  "i": 9,
  "start": 19.818,
  "end": 20.895,
  "text": "Tapi mereka tertawa."
 },
 {
  "i": 10,
  "start": 21.569,
  "end": 24.138,
  "text": "Hai Hud, kamu tidak membawa bukti apa pun!"
 },
 {
  "i": 11,
  "start": 24.704,
  "end": 27.599,
  "text": "Kami tidak akan meninggalkan tuhan-tuhan kami hanya karena ucapanmu!"
 },
 {
  "i": 12,
  "start": 28.252,
  "end": 29.825,
  "text": "Bahkan mereka menghina:"
 },
 {
  "i": 13,
  "start": 30.714,
  "end": 31.45,
  "text": "Kami rasa…"
 },
 {
  "i": 14,
  "start": 31.676,
  "end": 33.687,
  "text": "sebagian tuhan kami telah membuatmu gila!"
 },
 {
  "i": 15,
  "start": 34.473,
  "end": 36.409,
  "text": "Nabi Hud tidak gentar sedikit pun."
 },
 {
  "i": 16,
  "start": 37.145,
  "end": 37.875,
  "text": "Ia sendirian…"
 },
 {
  "i": 17,
  "start": 38.216,
  "end": 39.604,
  "text": "di hadapan bangsa raksasa."
 },
 {
  "i": 18,
  "start": 40.397,
  "end": 44.34,
  "text": "Tapi suaranya tegas: Aku berlepas diri dari apa yang kalian sembah!"
 },
 {
  "i": 19,
  "start": 45.163,
  "end": 45.478,
  "text": "Silakan…"
 },
 {
  "i": 20,
  "start": 46.075,
  "end": 48.28,
  "text": "lakukan tipu daya kalian semua terhadapku…"
 },
 {
  "i": 21,
  "start": 48.972,
  "end": 50.646,
  "text": "dan jangan beri aku tangguh sedikit pun!"
 },
 {
  "i": 22,
  "start": 51.261,
  "end": 53.025,
  "text": "Aku bertawakal kepada Allah…"
 },
 {
  "i": 23,
  "start": 53.463,
  "end": 54.959,
  "text": "Tuhanku dan Tuhan kalian!"
 },
 {
  "i": 24,
  "start": 55.971,
  "end": 60.138,
  "text": "Kaum 'Ad semakin menantang: Datangkan saja azab yang kamu ancamkan itu…"
 },
 {
  "i": 25,
  "start": 60.534,
  "end": 61.415,
  "text": "jika kamu benar!"
 },
 {
  "i": 26,
  "start": 62.533,
  "end": 63.143,
  "text": "Dan Allah…"
 },
 {
  "i": 27,
  "start": 63.574,
  "end": 64.935,
  "text": "mengabulkan tantangan mereka."
 }
]