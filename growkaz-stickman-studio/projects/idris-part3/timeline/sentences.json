[
 {
  "i": 0,
  "start": 0.38,
  "end": 0.985,
  "text": "Part tiga."
 },
 {
  "i": 1,
  "start": 1.374,
  "end": 3.178,
  "text": "Diangkat ke Tempat yang Tinggi."
 },
 {
  "i": 2,
  "start": 4.179,
  "end": 8.954,
  "text": "Allah SWT berfirman: \"Dan Kami telah mengangkatnya ke tempat yang tinggi.\""
 },
 {
  "i": 3,
  "start": 9.59,
  "end": 11.441,
  "text": "Q S Maryam ayat lima puluh tujuh."
 },
 {
  "i": 4,
  "start": 12.307,
  "end": 14.154,
  "text": "Tempat yang tinggi…"
 },
 {
  "i": 5,
  "start": 15.122,
  "end": 15.942,
  "text": "Apa maksudnya?"
 },
 {
  "i": 6,
  "start": 15.962,
  "end": 21.735,
  "text": "Ribuan tahun kemudian, jawabannya terungkap dalam satu malam yang menakjubkan…"
 },
 {
  "i": 7,
  "start": 22.567,
  "end": 23.164,
  "text": "Isra Mi'raj."
 },
 {
  "i": 8,
  "start": 23.184,
  "end": 26.588,
  "text": "Saat Rasulullah SAW naik menembus langit, di langit keempat…"
 },
 {
  "i": 9,
  "start": 27.016,
  "end": 27.994,
  "text": "beliau bertemu seseorang."
 },
 {
  "i": 10,
  "start": 28.775,
  "end": 33.042,
  "text": "Orang itu menyambut dengan hangat: \"Selamat datang, wahai saudara yang saleh…"
 },
 {
  "i": 11,
  "start": 33.429,
  "end": 34.362,
  "text": "dan nabi yang saleh.\""
 },
 {
  "i": 12,
  "start": 35.202,
  "end": 36.798,
  "text": "Siapakah dia?"
 },
 {
  "i": 13,
  "start": 37.285,
  "end": 37.705,
  "text": "Dialah…"
 },
 {
  "i": 14,
  "start": 37.725,
  "end": 38.616,
  "text": "Nabi Idris AS."
 },
 {
  "i": 15,
  "start": 39.552,
  "end": 41.636,
  "text": "Seorang manusia biasa yang tekun belajar…"
 },
 {
  "i": 16,
  "start": 41.986,
  "end": 42.958,
  "text": "sabar berdakwah…"
 },
 {
  "i": 17,
  "start": 43.235,
  "end": 44.338,
  "text": "dan jujur kepada Allah…"
 },
 {
  "i": 18,
  "start": 44.816,
  "end": 46.53,
  "text": "dimuliakan hingga ke langit."
 },
 {
  "i": 19,
  "start": 47.577,
  "end": 50.042,
  "text": "Hikmahnya: Ilmu yang diiringi iman…"
 },
 {
  "i": 20,
  "start": 50.315,
  "end": 51.808,
  "text": "dan kesabaran dalam kebaikan…"
 },
 {
  "i": 21,
  "start": 52.018,
  "end": 55.346,
  "text": "akan mengangkat derajat seseorang, di dunia dan di akhirat."
 },
 {
  "i": 22,
  "start": 55.759,
  "end": 58.108,
  "text": "Ikuti terus kisah para nabi selanjutnya!"
 }
]